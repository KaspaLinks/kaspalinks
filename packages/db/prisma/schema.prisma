generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum ActionType {
  KASPA_TRANSFER @map("kaspa.transfer")
  KASPA_TIP      @map("kaspa.tip")
  KASPA_DONATION @map("kaspa.donation")
  KASPA_INVOICE  @map("kaspa.invoice")
  KASPA_GOAL     @map("kaspa.goal")
}

enum Network {
  MAINNET
  TESTNET
}

enum PaymentRequestStatus {
  PENDING
  CONFIRMED
  EXPIRED
  FAILED
}

enum AuditActorType {
  SYSTEM
  ADMIN
  CREATOR
  PUBLIC
  DEMO
}

enum TelegramOutboxStatus {
  PENDING
  PROCESSING
  SENT
  DEAD
}

enum AgentIntentStatus {
  PENDING_CONFIRMATION
  NEEDS_CLARIFICATION
  EXECUTING
  CONFIRMED
  FAILED
  EXPIRED
  CANCELLED
}

enum NotificationRuleStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum NotificationRuleKind {
  ALL_PAYMENTS
  ACTION
  MINIMUM_AMOUNT
  ACTION_MINIMUM_AMOUNT
}

// Phase of a covenant-enforced prize. Mirrors the state commitment the script
// carries, so a row and its on-chain address can be checked against each other.
enum GiveawayPrizeCovenantPhase {
  OPEN
  FROZEN
  SETTLED
  REFUNDED
}

enum GiveawayStatus {
  OPEN
  DRAWN
  NO_ENTRIES
  CANCELLED
}

model Creator {
  id                      String                @id @default(cuid())
  username                String                @unique
  displayName             String?
  // Short public-facing description shown on /u/<username>. Optional.
  bio                     String?
  // Whitelisted public social links shown on /u/<username>. JSON keeps
  // platform additions additive while validation stays in app code.
  socialLinks             Json?
  defaultRecipientAddress String?
  timezone                String                @default("UTC")
  telegramBetaEnabled     Boolean               @default(false)
  // Gates the covenant-enforced giveaway prize (protocol v3) while it is
  // only exercised on one account.
  prizeCovenantEnabled    Boolean               @default(false)
  covenantPrototypes     CovenantPrototype[]
  agentAiEnabled          Boolean               @default(false)
  agentAiConsentAt        DateTime?
  agentWaitlistAt         DateTime?
  // FK into Action that this creator wants surfaced as the canonical
  // "quick tip" target on their profile page. Auto-set to the first
  // visible active Action a creator creates (so a fresh profile starts
  // working with zero extra setup), but the creator can override it via
  // dashboard settings later. Nullable because
  //   (a) a brand-new creator has no Actions yet
  //   (b) onDelete: SetNull means deleting the chosen Action leaves the
  //       profile in a "no quick-tip card" state instead of FK-cascading
  //       the whole profile away.
  tipActionId             String?
  tipAction               Action?               @relation("CreatorTipAction", fields: [tipActionId], references: [id], onDelete: SetNull)
  tokenHash               String
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  actions                 Action[]
  auditLogs               AuditLog[]
  claimableBatches        ClaimableBatch[]
  claimableLinks          ClaimableLink[]
  giveaways               Giveaway[]
  telegramConnection      TelegramConnection?
  telegramConnectCodes    TelegramConnectCode[]
  paymentEvents           PaymentEvent[]
  agentIntentDrafts       AgentIntentDraft[]
  aiUsageEvents           AiUsageEvent[]
  notificationRules       NotificationRule[]

  @@index([tipActionId])
  @@index([createdAt])
}

model Action {
  id                String             @id @default(cuid())
  publicId          String             @unique @default(cuid())
  creatorId         String?
  creator           Creator?           @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  slug              String?
  version           String             @default("v1")
  type              ActionType
  title             String
  description       String?
  recipientAddress  String
  amountSompi       BigInt?
  // Fundraising target for goal / crowdfunding links (type KASPA_GOAL).
  // Null for every other type. For goals, amountSompi stays null (each
  // supporter picks their own contribution) and goalSompi holds the
  // target the progress bar fills toward. Progress is computed as the
  // sum of confirmed PaymentRequest.amountSompi for the Action.
  goalSompi         BigInt?
  // Goal-only guard. When true, the public payment flow stops creating
  // new PaymentRequests once confirmed contributions meet or exceed
  // goalSompi. Existing pending requests are left alone until they
  // confirm or expire.
  goalAutoClose     Boolean            @default(false)
  message           String?
  // When true, the public pay page enforces that the supporter enters a
  // note before the Pay button enables. Used for commission / custom-
  // request links where the creator needs context with the payment
  // (e.g. "what should I draw", "which feature to prioritise", shout-out
  // text). Server-side guard in /api/actions/[publicId]/payment-requests
  // rejects requests that violate this on existing actions.
  noteRequired      Boolean            @default(false)
  // When true, this Action is excluded from the creator's public profile
  // page (/u/<username>). Default depends on type — tip + donation are
  // public by default (point of those is broad reach), invoice + transfer
  // hide by default (usually 1-recipient-specific and should not leak
  // names/amounts on a public profile). The /new-link form exposes a
  // checkbox so the creator can override.
  hiddenFromProfile Boolean            @default(false)
  network           Network            @default(MAINNET)
  expiresAt         DateTime?
  disabledAt        DateTime?
  deletedAt         DateTime?
  invoicePaidAt     DateTime?
  agentCommandKey   String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  paymentRequests   PaymentRequest[]
  auditLogs         AuditLog[]
  // Inverse side of Creator.tipAction — lets the schema be consistent
  // when a single Action is picked as the canonical tip target of one
  // or more creators (in practice always at most one, but Prisma needs
  // the relation declared on both sides).
  tipForCreators    Creator[]          @relation("CreatorTipAction")
  paymentEvents     PaymentEvent[]
  notificationRules NotificationRule[]

  @@unique([creatorId, slug])
  @@index([type])
  @@index([creatorId])
  @@index([slug])
  @@index([recipientAddress])
  @@index([expiresAt])
  @@index([deletedAt])
  @@index([invoicePaidAt])
}

model PaymentRequest {
  id                String               @id @default(cuid())
  actionId          String
  action            Action               @relation(fields: [actionId], references: [id], onDelete: Restrict)
  status            PaymentRequestStatus @default(PENDING)
  recipientAddress  String
  amountSompi       BigInt?
  network           Network
  paymentUri        String?
  requestedMessage  String?
  supporterMessage  String?
  // Optional public attribution for the creator's supporter wall.
  // supporterPublic is controlled by the supporter opt-in on the pay page;
  // supporterHiddenAt lets the creator hide an entry later without deleting
  // the payment request or audit trail. Wallet addresses are never shown on
  // the public wall.
  supporterName     String?
  supporterPublic   Boolean              @default(false)
  supporterHiddenAt DateTime?
  fakeTxId          String?              @unique
  txId              String?              @unique
  detectionSource   String?
  expiresAt         DateTime
  confirmedAt       DateTime?
  failedAt          DateTime?
  detectionAttempts Int                  @default(0)
  nextDetectionAt   DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  auditLogs         AuditLog[]
  paymentEvent      PaymentEvent?

  @@index([actionId])
  @@index([status])
  @@index([expiresAt])
  @@index([supporterPublic])
  @@index([supporterHiddenAt])
  @@index([confirmedAt])
  @@index([status, nextDetectionAt])
}

model AuditLog {
  id               String          @id @default(cuid())
  creatorId        String?
  creator          Creator?        @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  actionId         String?
  action           Action?         @relation(fields: [actionId], references: [id], onDelete: SetNull)
  paymentRequestId String?
  paymentRequest   PaymentRequest? @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)
  event            String
  actorType        AuditActorType  @default(SYSTEM)
  metadata         Json?
  ipHash           String?
  createdAt        DateTime        @default(now())

  @@index([creatorId])
  @@index([actionId])
  @@index([paymentRequestId])
  @@index([event])
  @@index([createdAt])
}

model TelegramConnection {
  id                      String           @id @default(cuid())
  creatorId               String           @unique
  creator                 Creator          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  telegramUserId          String           @unique
  telegramChatId          String           @unique
  notificationsEnabled    Boolean          @default(false)
  supporterDetailsEnabled Boolean          @default(false)
  blockedAt               DateTime?
  disabledReason          String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  outboxDeliveries        TelegramOutbox[]

  @@index([blockedAt])
}

model TelegramConnectCode {
  id         String    @id @default(cuid())
  creatorId  String
  creator    Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  codeHash   String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([creatorId, expiresAt])
}

model TelegramConnectAttempt {
  id              String    @id @default(cuid())
  telegramUserId  String    @unique
  windowStartedAt DateTime
  attempts        Int       @default(0)
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
}

model TelegramUpdate {
  id           String    @id @default(cuid())
  updateId     String    @unique
  receivedAt   DateTime  @default(now())
  processingAt DateTime?
  attempts     Int       @default(0)
  processedAt  DateTime?
  errorCode    String?

  @@index([receivedAt])
  @@index([processingAt])
}

model PaymentEvent {
  id               String           @id @default(cuid())
  paymentRequestId String?          @unique
  paymentRequest   PaymentRequest?  @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)
  actionId         String?
  action           Action?          @relation(fields: [actionId], references: [id], onDelete: SetNull)
  creatorId        String?
  creator          Creator?         @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  amountSompi      BigInt
  txId             String
  occurredAt       DateTime
  createdAt        DateTime         @default(now())
  telegramOutbox   TelegramOutbox[]

  @@index([creatorId, occurredAt])
  @@index([actionId, occurredAt])
  @@index([txId])
}

model TelegramOutbox {
  id             String                        @id @default(cuid())
  creatorId      String?
  connectionId   String?
  connection     TelegramConnection?           @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  paymentEventId String?
  paymentEvent   PaymentEvent?                 @relation(fields: [paymentEventId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   TelegramGiveawaySubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  dedupeKey      String                        @unique
  kind           String
  payload        Json
  matchedRuleIds Json?
  status         TelegramOutboxStatus          @default(PENDING)
  attempts       Int                           @default(0)
  availableAt    DateTime                      @default(now())
  lockedAt       DateTime?
  sentAt         DateTime?
  lastErrorCode  String?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  @@index([status, availableAt])
  @@index([creatorId, createdAt])
  @@index([connectionId])
  @@index([subscriptionId])
}

model AgentIntentDraft {
  id             String            @id @default(cuid())
  creatorId      String
  creator        Creator           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  telegramUserId String
  intent         String
  payload        Json
  status         AgentIntentStatus @default(PENDING_CONFIRMATION)
  expiresAt      DateTime
  confirmedAt    DateTime?
  resultRef      String?
  sourceUpdateId String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([creatorId, status])
  @@index([telegramUserId, expiresAt])
}

model AiUsageEvent {
  id                  String   @id @default(cuid())
  creatorId           String
  creator             Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  model               String
  intent              String?
  status              String
  inputTokens         Int?
  outputTokens        Int?
  estimatedCostMicros BigInt   @default(0)
  errorCode           String?
  createdAt           DateTime @default(now())

  @@index([creatorId, createdAt])
  @@index([createdAt])
}

model AgentQuotaBucket {
  id                  String   @id @default(cuid())
  scope               String
  scopeKey            String
  periodKey           String
  requestCount        Int      @default(0)
  estimatedCostMicros BigInt   @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([scope, scopeKey, periodKey])
  @@index([scope, periodKey])
}

model NotificationRule {
  id                       String                 @id @default(cuid())
  creatorId                String
  creator                  Creator                @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  actionId                 String?
  action                   Action?                @relation(fields: [actionId], references: [id], onDelete: Cascade)
  kind                     NotificationRuleKind
  minimumSompi             BigInt?
  status                   NotificationRuleStatus @default(ACTIVE)
  completeOnInvoicePayment Boolean                @default(false)
  completedAt              DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([creatorId, status])
  @@index([actionId])
}

model OperatorPageView {
  id             String   @id @default(cuid())
  eventHash      String   @unique
  visitorDayHash String
  seenAt         DateTime
  path           String
  referrer       String
  utmSource      String?
  countryCode    String?
  device         String
  browser        String
  status         Int
  isBot          Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([seenAt])
  @@index([visitorDayHash])
  @@index([path])
  @@index([referrer])
  @@index([utmSource])
  @@index([countryCode])
  @@index([device])
  @@index([browser])
  @@index([isBot])
}

// Non-custodial claimable links (Toccata lab). Stores ONLY non-secret metadata:
// the funding address + public keys + status, never the claim/refund private
// codes (those stay in encrypted browser storage + share URL fragments).
// A separate table keeps the shared Action model and its public-facing queries
// untouched. linkKey is the client-generated id shared with the localStorage
// record and the URL fragment, so /my-links can merge server status with the
// browser-held secrets.
model ClaimableLink {
  id                 String    @id @default(cuid())
  creatorId          String
  creator            Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  linkKey            String    @unique
  title              String
  description        String?
  amountSompi        BigInt
  feeSompi           BigInt
  fundingAddress     String
  claimPublicKey     String
  refundPublicKey    String
  refundLockTime     String
  redeemScriptHex    String
  fundingTxId        String?
  fundingOutputIndex Int?
  claimTxId          String?
  claimedAt          DateTime?
  refundTxId         String?
  refundedAt         DateTime?
  status             String    @default("awaiting_funding")
  network            Network   @default(MAINNET)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  prizeForGiveaway   Giveaway?

  @@unique([creatorId, linkKey])
  @@index([creatorId])
  @@index([deletedAt])
  @@index([status])
  @@index([claimedAt])
  @@index([refundedAt])
  @@index([fundingAddress])
}

// Public, non-secret manifest for a one-time batch allocator. It commits the
// exact ordered child outputs that the browser-created covenant can produce.
// Activation and refund private keys remain exclusively in browser storage.
model ClaimableBatch {
  id                    String   @id @default(cuid())
  creatorId             String
  creator               Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  batchKey              String   @unique
  title                 String
  activationPublicKey   String
  refundPublicKey       String
  refundLockTime        String
  fundingAddress        String
  fundingAmountSompi    BigInt
  activationFeeSompi    BigInt
  redeemScriptHex       String
  expectedOutputs       Json
  fundingTxId           String?
  fundingOutputIndex    Int?
  pendingActivationTxId String?
  activationTxId        String?
  pendingRefundTxId     String?
  refundTxId            String?
  status                String   @default("awaiting_funding")
  network               Network  @default(MAINNET)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([creatorId, batchKey])
  @@index([creatorId])
  @@index([status])
  @@index([fundingAddress])
}

// Lab-only, non-custodial giveaway registration. The server stores public
// contest terms and participant payout addresses, but never wallet keys or
// funds. drawSeedHex is a fairness seed committed before entries open; it is
// revealed only after the one-time draw so the result can be independently
// reproduced.
model Giveaway {
  id                            String                         @id @default(cuid())
  publicId                      String                         @unique @default(cuid())
  creatorId                     String
  creator                       Creator                        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title                         String
  description                   String?
  amountSompi                   BigInt
  closesAt                      DateTime
  status                        GiveawayStatus                 @default(OPEN)
  // Draw protocol v1 used only the precommitted server seed. Protocol v2
  // freezes the entry set before deriving the result from future Kaspa chain
  // entropy. Existing rows remain v1 for backwards-compatible verification.
  drawProtocolVersion           Int                            @default(1)
  drawSeedHex                   String
  drawCommitment                String
  drawDigest                    String?
  entriesRoot                   String?
  entriesFrozenAt               DateTime?
  entropyTargetBlueScore        BigInt?
  entropyBlockBlueScore         BigInt?
  entropyBlockHash              String?
  winnerIndex                   Int?
  winnerEntryId                 String?
  winnerAddress                 String?
  entryCountAtDraw              Int?
  drawnAt                       DateTime?
  // Prize-backed giveaways do not open until the linked output is confirmed.
  // entryWindowSeconds preserves the creator's chosen duration so closesAt can
  // start from the actual on-chain funding confirmation instead of creation.
  entryWindowSeconds            Int?
  openedAt                      DateTime?
  // The winner can trigger a prepared, fixed-destination payout during this
  // window. The creator's browser signs it after the draw; no private key is
  // ever sent to or stored by the server.
  winnerClaimWindowSeconds      Int?
  winnerClaimExpiresAt          DateTime?
  prizeClaimPreparedAt          DateTime?
  prizeClaimTransactionId       String?                        @unique
  prizeClaimTransactionSafeJson String?
  // Covenant-enforced prize (protocol v3). Null on every earlier giveaway.
  //
  // These carry everything needed to re-derive the redeem script and its
  // address from the row alone, so a route never trusts a client-supplied
  // script. The platform and creator keys are stored per giveaway rather than
  // read from configuration, because rotating the platform key must not change
  // the address of a giveaway that is already funded.
  prizeCovenantVersion          Int?
  prizeCovenantPhase            GiveawayPrizeCovenantPhase?
  prizeCovenantPlatformKey      String?
  prizeCovenantCreatorKey       String?
  prizeCovenantDrawFeeSompi     BigInt?
  prizeCovenantClosesAtDaa      BigInt?
  prizeCovenantRefundDaa        BigInt?
  prizeCovenantAddress          String?                        @unique
  prizeCovenantFreezeTxId       String?                        @unique
  prizeCovenantDrawTxId         String?                        @unique
  // Optional escrow: the prize is parked in a claimable link whose claim code
  // stays in the creator's browser. Proves the prize exists without custody.
  prizeLinkKey                  String?                        @unique
  prizeLink                     ClaimableLink?                 @relation(fields: [prizeLinkKey], references: [linkKey], onDelete: SetNull)
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  entries                       GiveawayEntry[]
  telegramSubscriptions         TelegramGiveawaySubscription[]
  telegramCheckedAt             DateTime?

  @@index([creatorId])
  @@index([status])
  @@index([closesAt])
  @@index([createdAt])
}

model GiveawayEntry {
  id         String   @id @default(cuid())
  giveawayId String
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  address    String
  ipHash     String?
  createdAt  DateTime @default(now())

  @@unique([giveawayId, address])
  @@index([giveawayId])
  @@index([createdAt])
}

// Public result subscriptions are separate from Creator authentication.
// No wallet ownership or prize entitlement is inferred from a Telegram ID.
model TelegramGiveawaySubscription {
  id               String           @id @default(cuid())
  giveawayId       String
  giveaway         Giveaway         @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  telegramUserId   String
  telegramChatId   String
  revokedAt        DateTime?
  resultQueuedAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  outboxDeliveries TelegramOutbox[]

  @@unique([giveawayId, telegramUserId])
  @@index([telegramUserId, revokedAt])
  @@index([resultQueuedAt, revokedAt])
}

// Isolated mainnet trials; never processed by the public giveaway worker.
// Only public covenant material and signed transaction IDs belong here.
model CovenantPrototype {
  id               String   @id @default(cuid())
  creatorId        String
  creator          Creator  @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  fundingAddress   String   @unique
  manifest         Json
  entropy          Json?
  createdAt        DateTime @default(now())
  @@index([creatorId, createdAt])
}
